# Copy this file to .env and fill in real values. .env is gitignored.

# Connects to the Postgres container started by docker-compose.yml at the repo root.
# Host is "localhost" because the backend runs on your machine, not inside Docker.
DATABASE_URL=postgresql://pantrypilot:pantrypilot@localhost:5432/pantrypilot

# Used to sign JWT tokens. Use a long random string in real deployments.
JWT_SECRET_KEY=change-me-to-a-random-string

FLASK_DEBUG=true
